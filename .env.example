# ==========================================================================
# Configuración del demo MCP (copiar a .env antes de levantar)
#   cp .env.example .env
# ==========================================================================

# --- SQL Server -----------------------------------------------------------
# Contraseña del usuario 'sa'. SQL Server exige una contraseña fuerte:
# min. 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Dev_Camaras_2026!
# Nombre de la base de datos que se crea y puebla en el arranque.
MSSQL_DB=DBCAMARADETECCIONIM

# --- Conexión del API a SQL Server ---------------------------------------
# 'sqlserver' es el nombre del servicio en docker-compose (red interna).
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
# Debe coincidir con MSSQL_SA_PASSWORD.
DB_PASSWORD=Dev_Camaras_2026!
DB_NAME=DBCAMARADETECCIONIM

# --- Seguridad JWT --------------------------------------------------------
# Clave para firmar los tokens. Cambiar por un valor aleatorio en cualquier
# entorno que no sea el demo local.
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-para-el-demo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Usuarios semilla (autenticación del API) -----------------------------
# Formato: usuario:contraseña separados por coma.
DEMO_USERS=admin:admin123,demo:demo123
